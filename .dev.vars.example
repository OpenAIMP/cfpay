# Copy this file to .dev.vars and fill in your secrets for local development.
# For production, use: npx wrangler secret put <NAME>

PAYMENT_PRIVATE_KEY=0xYourWalletPrivateKey
EMAIL_SECRET=your-random-secret-string-for-secure-replies
DASHBOARD_API_KEY=your-dashboard-api-key
# Webhook secrets (for verifying incoming webhook signatures)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
SLACK_WEBHOOK_SECRET=your-slack-signing-secret
# Slack secrets (used for signature verification, Socket Mode, and OAuth)
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_CLIENT_ID=your-slack-client-id
