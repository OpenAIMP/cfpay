# Copy this file to .dev.vars and fill in your secrets for local development.
# For production, use: npx wrangler secret put <NAME>

PAYMENT_PRIVATE_KEY=0xYourWalletPrivateKey
EMAIL_SECRET=your-random-secret-string-for-secure-replies
DASHBOARD_API_KEY=your-dashboard-api-key
# Webhook secrets (for verifying incoming webhook signatures)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
SLACK_WEBHOOK_SECRET=your-slack-signing-secret
# Slack secrets (used for signature verification, Socket Mode, and OAuth)
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_CLIENT_ID=your-slack-client-id
# SLACK_CLIENT_SECRET=your-slack-client-secret  # for the /slack/install OAuth flow

# Optional: outgoing Slack notifications (the dashboard's "Send to Slack" button
# and webhook-received notifications). This is an INCOMING WEBHOOK URL from
# your Slack app, not a signing secret, and is unrelated to SLACK_WEBHOOK_SECRET
# above despite the similar name. Leave it unset and the button will simply
# report that it is not configured.
#   SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Optional: restrict the dashboard's "send webhook" RPC to URL prefixes.
# Unset = any URL allowed (a warning is logged).
#   OUTBOUND_WEBHOOK_ALLOWLIST=https://hooks.slack.com/,https://example.com/hooks/

# Optional: email a human when a webhook event arrives. Leave unset to keep
# webhook events dashboard-only. WEBHOOK_NOTIFY_PROVIDERS is an optional
# comma-separated allowlist (github, stripe, slack).
#   WEBHOOK_NOTIFY_EMAIL=you@example.com
#   WEBHOOK_NOTIFY_PROVIDERS=github

# Optional: Stripe card payments. Both must be present to enable card checkout.
# STRIPE_SECRET_KEY is a server-side key (sk_...); add it to the GitHub PROD
# environment for production. STRIPE_CONFIG lives in wrangler.jsonc.
#   STRIPE_SECRET_KEY=sk_test_...
# For local webhook testing: stripe listen --forward-to localhost:8787/webhooks/stripe

# --- Public.com chat (https://mcp.public.com/mcp) ----------------------------
# No client id or redirect is needed: Public.com publishes no registration
# endpoint, so the OAuth flow cannot be driven from here. Users paste a personal
# access token into the dashboard's Public.com tab; it is stored server-side,
# behind DASHBOARD_API_KEY, and never returned to the browser.

# Read-only by default. Their server also exposes order placement, and their
# documentation warns a trade through an MCP client is a real order using real
# money. Set this to true only if you intend the agent to place orders.
# PUBLIC_ALLOW_TRADING=false

# --- Agent-to-agent (A2A) ------------------------------------------------------
# The CFmail agent calls the payments agent over A2A, which needs this Worker's
# own origin: a Worker cannot discover its hostname without an inbound request,
# and an inter-agent call may happen outside one.
# SELF_ORIGIN=https://pay.openaimp.com
