# Copy this file to .dev.vars and fill in your secrets for local development.
# For production, use: npx wrangler secret put <NAME>

# Webhook secrets (for verifying incoming webhook signatures)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
SLACK_WEBHOOK_SECRET=your-slack-signing-secret

# Outgoing Slack incoming-webhook URL (optional — for notifications)
SLACK_WEBHOOK_URL=
