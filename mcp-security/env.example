# =============================================================================
# MCP Portal Security — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# All scripts source .env automatically if it exists.

# --- Cloudflare Account ---
# Your Cloudflare account ID (found in dashboard URL or right sidebar)
CLOUDFLARE_ACCOUNT_ID="1e7e9bb45eca8d59ec86bbd6dac9b900"

# Cloudflare API token with these permissions:
#   - Access: Apps and Policies Write
#   - Access: Organizations, Identity Providers, and Groups Write
#   - DNS: Edit (for the zone containing openaimp.com)
#   - Access: Apps and Policies Read
CLOUDFLARE_API_TOKEN=""

# Your Cloudflare Zero Trust team name (subdomain of cloudflareaccess.com)
# Found in Zero Trust > Settings > Team name and domain > Team name
CF_TEAM_NAME=""

# --- Zone ---
# The zone name for DNS management (must be an active zone in your account)
ZONE_NAME="openaimp.com"

# --- MCP Server (upstream, unauthenticated) ---
# The existing unauthenticated MCP server URL — NO code changes needed
UPSTREAM_MCP_URL="https://pay.openaimp.com/mcp"

# --- MCP Portal (protected endpoint) ---
# The subdomain for the protected MCP portal
PORTAL_SUBDOMAIN="mcp"
# Full portal hostname (constructed as PORTAL_SUBDOMAIN.ZONE_NAME)
PORTAL_HOSTNAME="mcp.openaimp.com"
# Portal name (display name in dashboard)
PORTAL_NAME="OpenAIMP MCP Portal"

# --- MCP Server Registration ---
MCP_SERVER_NAME="OpenAIMP Pay Server"

# --- Access Policy ---
# Email addresses or domains allowed to access the portal
# Comma-separated, e.g. "openaimp@openaimp.com,@openaimp.com"
ALLOWED_EMAILS="openaimp@openaimp.com"

# --- Identity Provider Credentials ---
# These are OPTIONAL — scripts will skip IdPs that don't have credentials.

# Google (consumer Google accounts, not Workspace)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Redirect URI: https://<CF_TEAM_NAME>.cloudflareaccess.com/cdn-cgi/access/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub
# Create OAuth App at https://github.com/settings/developers
# Redirect URI: https://<CF_TEAM_NAME>.cloudflareaccess.com/cdn-cgi/access/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Okta (free Developer Edition: https://developer.okta.com/signup/)
# Create an OIDC app integration in Okta
# Redirect URI: https://<CF_TEAM_NAME>.cloudflareaccess.com/cdn-cgi/access/callback
OKTA_CLIENT_ID=""
OKTA_CLIENT_SECRET=""
OKTA_ACCOUNT_URL=""  # e.g. https://dev-12345678.okta.com
